# ── Knowledge engine SDK config (loadKnowledgeConfig) ───────────────────────
# The SDK mounts onto your Interchange app; the host owns auth, tenancy, and
# grants. These vars configure only the knowledge/vector plane.

# Knowledge / vector Postgres (compose.yml → localhost:5434).
KNOWLEDGE_DATABASE_URL=postgres://knowledge:knowledge-dev-password@localhost:5434/knowledge
DB_POOL_MAX=8

# Embeddings (compose.yml → Ollama on :11434). The engine never embeds
# in-process; it always calls this endpoint. Swap four vars for a hosted
# provider (e.g. EMBED_BASE_URL=https://api.openai.com, EMBED_API_STYLE=openai).
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_API_STYLE=ollama
EMBED_API_KEY=

# Cross-encoder reranker (compose.yml → TEI on :8085). Optional — retrieval
# degrades to fusion-only if unset.
RERANK_BASE_URL=http://localhost:8085
RERANK_MODEL=bge-reranker-base
RERANK_API_KEY=
# Per-document character budget sent to the reranker (TEI rejects the whole
# batch if any single document exceeds the model's token limit; the query's
# length is also reserved out of this budget). Default 1500 passes
# mountKnowledgeEngine's startup validation against bge-reranker-base's 512
# tokens using a ~3 chars/token estimate. That estimate is a floor, not a
# guarantee — CJK, code, or base64 content can run closer to ~1 char/token
# and may still exceed the model's real limit; lower this for such corpora.
RERANK_MAX_DOC_CHARS=1500
