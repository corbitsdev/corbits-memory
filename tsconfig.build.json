{
  // Publish build: emits dist/ (js + d.ts) for the packed tarball.
  // Source stays the dev surface (bun test, typecheck); dist is what
  // the `default`/`types` export conditions resolve to once packed.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "dist", "node_modules"]
}
